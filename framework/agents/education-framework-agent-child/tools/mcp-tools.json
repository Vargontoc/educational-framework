{
  "schema_version": "v1",
  "agent": "education-framework-agent-child",
  "description": "Approved MCP tools available to this agent. Backend is responsible for execution, consent gating, and audit logging.",
  "tools": [
    {
      "name": "fetch_child_profile",
      "description": "Retrieve non-PII profile fields for the child. Backend redacts sensitive data before returning.",
      "destructive": false,
      "input_schema": {
        "type": "object",
        "required": ["child_id"],
        "additionalProperties": false,
        "properties": {
          "child_id": { "type": "string" }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "age": { "type": "integer" },
          "activity_level": { "type": "string", "enum": ["beginner", "intermediate", "advanced"] },
          "preferred_content_type": { "type": "string", "enum": ["plain_text", "tts_snippet", "structured_activity"] }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "fetch_recommended_activity",
      "description": "Get the next recommended activity for the child based on their profile and current activity.",
      "destructive": false,
      "input_schema": {
        "type": "object",
        "required": ["child_id"],
        "additionalProperties": false,
        "properties": {
          "child_id": { "type": "string" },
          "current_activity_id": { "type": "string" }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "activity_id": { "type": "string" },
          "activity_name": { "type": "string" },
          "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "record_event",
      "description": "Append-only event log write. Backend writes to audit log. No delete or update allowed.",
      "destructive": false,
      "input_schema": {
        "type": "object",
        "required": ["child_id", "event_type"],
        "additionalProperties": false,
        "properties": {
          "child_id": { "type": "string" },
          "event_type": { "type": "string" },
          "metadata": { "type": "object" }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "recorded": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "send_parent_notification",
      "description": "Queue a notification to the parent. Backend gates on parent_notifications_enabled consent flag before delivery.",
      "destructive": false,
      "input_schema": {
        "type": "object",
        "required": ["child_id", "reason"],
        "additionalProperties": false,
        "properties": {
          "child_id": { "type": "string" },
          "reason": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "queued": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  ]
}
