<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="038__add_biome_to_avatar_event_catalog" author="vargontoc">
        <addColumn tableName="avatar_event_catalog">
            <column name="biome" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <createIndex indexName="idx_avatar_event_catalog_biome" tableName="avatar_event_catalog">
            <column name="biome"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
