<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="021__create_activity_proposal_log" author="vargontoc">

        <createTable tableName="activity_proposal_log">
            <column name="id" type="BIGSERIAL">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="child_profile_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="child_session_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="activity_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="topic_id" type="BIGINT"/>
            <column name="outcome" type="VARCHAR(20)"/>
            <column name="proposed_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="resolved_at" type="TIMESTAMPTZ"/>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="activity_proposal_log"
            baseColumnNames="child_profile_id"
            constraintName="fk_activity_proposal_log_child_profile"
            referencedTableName="child_profile"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="activity_proposal_log"
            baseColumnNames="child_session_id"
            constraintName="fk_activity_proposal_log_child_session"
            referencedTableName="child_session"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="activity_proposal_log"
            baseColumnNames="activity_id"
            constraintName="fk_activity_proposal_log_activity"
            referencedTableName="activity"
            referencedColumnNames="id"/>

        <createIndex indexName="idx_activity_proposal_log_child_profile" tableName="activity_proposal_log">
            <column name="child_profile_id"/>
        </createIndex>

        <createIndex indexName="idx_activity_proposal_log_child_session" tableName="activity_proposal_log">
            <column name="child_session_id"/>
        </createIndex>

        <createIndex indexName="idx_activity_proposal_log_activity" tableName="activity_proposal_log">
            <column name="activity_id"/>
        </createIndex>

        <createIndex indexName="idx_activity_proposal_log_topic" tableName="activity_proposal_log">
            <column name="topic_id"/>
        </createIndex>

        <createIndex indexName="idx_activity_proposal_log_proposed_at" tableName="activity_proposal_log">
            <column name="proposed_at"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>