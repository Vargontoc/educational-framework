<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="015__create_tracking_schema" author="vargontoc">

        <!-- Activity Attempt table -->
        <createTable tableName="activity_attempt">
            <column name="id" type="BIGSERIAL">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="child_profile_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="activity_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="child_session_id" type="BIGINT"/>
            <column name="topic_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="difficulty_level_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="result" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="response_time_ms" type="INTEGER"/>
            <column name="attempt_context" type="TEXT"/>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="activity_attempt"
            baseColumnNames="child_profile_id"
            constraintName="fk_activity_attempt_child_profile"
            referencedTableName="child_profile"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="activity_attempt"
            baseColumnNames="activity_id"
            constraintName="fk_activity_attempt_activity"
            referencedTableName="activity"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="activity_attempt"
            baseColumnNames="child_session_id"
            constraintName="fk_activity_attempt_child_session"
            referencedTableName="child_session"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="activity_attempt"
            baseColumnNames="topic_id"
            constraintName="fk_activity_attempt_topic"
            referencedTableName="topic"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="activity_attempt"
            baseColumnNames="difficulty_level_id"
            constraintName="fk_activity_attempt_difficulty_level"
            referencedTableName="difficulty_level"
            referencedColumnNames="id"/>

        <createIndex indexName="idx_activity_attempt_child_activity_created" tableName="activity_attempt">
            <column name="child_profile_id"/>
            <column name="activity_id"/>
            <column name="created_at"/>
        </createIndex>

        <createIndex indexName="idx_activity_attempt_child_topic_created" tableName="activity_attempt">
            <column name="child_profile_id"/>
            <column name="topic_id"/>
            <column name="created_at"/>
        </createIndex>

        <createIndex indexName="idx_activity_attempt_session_created" tableName="activity_attempt">
            <column name="child_session_id"/>
            <column name="created_at"/>
        </createIndex>

        <createIndex indexName="idx_activity_attempt_created_at" tableName="activity_attempt">
            <column name="created_at"/>
        </createIndex>

        <!-- Activity Summary table -->
        <createTable tableName="activity_summary">
            <column name="id" type="BIGSERIAL">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="child_profile_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="activity_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="total_attempts" type="INTEGER" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="total_correct" type="INTEGER" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="total_incorrect" type="INTEGER" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="total_timeouts" type="INTEGER" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="success_rate_percent" type="DECIMAL(5,2)"/>
            <column name="average_response_time_ms" type="INTEGER"/>
            <column name="current_difficulty_level_id" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="activity_summary"
            baseColumnNames="child_profile_id"
            constraintName="fk_activity_summary_child_profile"
            referencedTableName="child_profile"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="activity_summary"
            baseColumnNames="activity_id"
            constraintName="fk_activity_summary_activity"
            referencedTableName="activity"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="activity_summary"
            baseColumnNames="current_difficulty_level_id"
            constraintName="fk_activity_summary_difficulty_level"
            referencedTableName="difficulty_level"
            referencedColumnNames="id"/>

        <addUniqueConstraint
            tableName="activity_summary"
            constraintName="uk_activity_summary_child_activity"
            columnNames="child_profile_id, activity_id"/>

        <createIndex indexName="idx_activity_summary_child" tableName="activity_summary">
            <column name="child_profile_id"/>
        </createIndex>

        <!-- Topic Summary table -->
        <createTable tableName="topic_summary">
            <column name="id" type="BIGSERIAL">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="child_profile_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="topic_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="total_attempts" type="INTEGER" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="total_correct" type="INTEGER" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="total_incorrect" type="INTEGER" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="total_timeouts" type="INTEGER" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="success_rate_percent" type="DECIMAL(5,2)"/>
            <column name="failure_rate_percent" type="DECIMAL(5,2)"/>
            <column name="average_response_time_ms" type="INTEGER"/>
            <column name="performance_band" type="VARCHAR(20)"/>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="topic_summary"
            baseColumnNames="child_profile_id"
            constraintName="fk_topic_summary_child_profile"
            referencedTableName="child_profile"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="topic_summary"
            baseColumnNames="topic_id"
            constraintName="fk_topic_summary_topic"
            referencedTableName="topic"
            referencedColumnNames="id"/>

        <addUniqueConstraint
            tableName="topic_summary"
            constraintName="uk_topic_summary_child_topic"
            columnNames="child_profile_id, topic_id"/>

        <createIndex indexName="idx_topic_summary_child" tableName="topic_summary">
            <column name="child_profile_id"/>
        </createIndex>

        <!-- Curiosity Viewed table -->
        <createTable tableName="curiosity_viewed">
            <column name="id" type="BIGSERIAL">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="child_profile_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="topic_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="curiosity_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="cycle_number" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="viewed_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="curiosity_viewed"
            baseColumnNames="child_profile_id"
            constraintName="fk_curiosity_viewed_child_profile"
            referencedTableName="child_profile"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="curiosity_viewed"
            baseColumnNames="topic_id"
            constraintName="fk_curiosity_viewed_topic"
            referencedTableName="topic"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="curiosity_viewed"
            baseColumnNames="curiosity_id"
            constraintName="fk_curiosity_viewed_curiosity"
            referencedTableName="curiosity"
            referencedColumnNames="id"/>

        <addUniqueConstraint
            tableName="curiosity_viewed"
            constraintName="uk_curiosity_viewed_child_topic_curiosity"
            columnNames="child_profile_id, topic_id, curiosity_id"/>

        <createIndex indexName="idx_curiosity_viewed_child_topic_cycle" tableName="curiosity_viewed">
            <column name="child_profile_id"/>
            <column name="topic_id"/>
            <column name="cycle_number"/>
        </createIndex>

        <createIndex indexName="idx_curiosity_viewed_child_curiosity" tableName="curiosity_viewed">
            <column name="child_profile_id"/>
            <column name="curiosity_id"/>
        </createIndex>

        <!-- Child Achievement table -->
        <createTable tableName="child_achievement">
            <column name="id" type="BIGSERIAL">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="child_profile_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="achievement_code" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="activity_id" type="BIGINT"/>
            <column name="topic_id" type="BIGINT"/>
            <column name="earned_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="child_achievement"
            baseColumnNames="child_profile_id"
            constraintName="fk_child_achievement_child_profile"
            referencedTableName="child_profile"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="child_achievement"
            baseColumnNames="activity_id"
            constraintName="fk_child_achievement_activity"
            referencedTableName="activity"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="child_achievement"
            baseColumnNames="topic_id"
            constraintName="fk_child_achievement_topic"
            referencedTableName="topic"
            referencedColumnNames="id"/>

        <!-- NULLS NOT DISTINCT required because activity_id and topic_id are nullable;
             standard UNIQUE treats NULL != NULL and would allow duplicate global achievements. -->
        <sql>
            CREATE UNIQUE INDEX uk_child_achievement_child_code
            ON child_achievement (child_profile_id, achievement_code, activity_id, topic_id)
            NULLS NOT DISTINCT;
        </sql>

        <createIndex indexName="idx_child_achievement_child" tableName="child_achievement">
            <column name="child_profile_id"/>
        </createIndex>

        <!-- Child Learning Progress table -->
        <createTable tableName="child_learning_progress">
            <column name="id" type="BIGSERIAL">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="child_profile_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="learning_path_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="current_learning_path_step_id" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="child_learning_progress"
            baseColumnNames="child_profile_id"
            constraintName="fk_child_learning_progress_child_profile"
            referencedTableName="child_profile"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="child_learning_progress"
            baseColumnNames="learning_path_id"
            constraintName="fk_child_learning_progress_learning_path"
            referencedTableName="learning_path"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="child_learning_progress"
            baseColumnNames="current_learning_path_step_id"
            constraintName="fk_child_learning_progress_step"
            referencedTableName="learning_path_step"
            referencedColumnNames="id"/>

        <addUniqueConstraint
            tableName="child_learning_progress"
            constraintName="uk_child_learning_progress_child_path"
            columnNames="child_profile_id, learning_path_id"/>

        <createIndex indexName="idx_child_learning_progress_child" tableName="child_learning_progress">
            <column name="child_profile_id"/>
        </createIndex>

        <!-- Child Learning Completed Step table -->
        <createTable tableName="child_learning_completed_step">
            <column name="id" type="BIGSERIAL">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="child_profile_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="learning_path_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="learning_path_step_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="completed_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="child_learning_completed_step"
            baseColumnNames="child_profile_id"
            constraintName="fk_child_learning_completed_step_child_profile"
            referencedTableName="child_profile"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="child_learning_completed_step"
            baseColumnNames="learning_path_id"
            constraintName="fk_child_learning_completed_step_learning_path"
            referencedTableName="learning_path"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="child_learning_completed_step"
            baseColumnNames="learning_path_step_id"
            constraintName="fk_child_learning_completed_step_step"
            referencedTableName="learning_path_step"
            referencedColumnNames="id"/>

        <addUniqueConstraint
            tableName="child_learning_completed_step"
            constraintName="uk_child_learning_completed_step_child_path_step"
            columnNames="child_profile_id, learning_path_id, learning_path_step_id"/>

        <createIndex indexName="idx_child_learning_completed_step_child_path" tableName="child_learning_completed_step">
            <column name="child_profile_id"/>
            <column name="learning_path_id"/>
            <column name="completed_at"/>
        </createIndex>

        <createIndex indexName="idx_child_learning_completed_step_child_step" tableName="child_learning_completed_step">
            <column name="child_profile_id"/>
            <column name="learning_path_step_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
