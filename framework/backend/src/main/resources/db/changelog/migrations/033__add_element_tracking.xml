<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="033__add_element_tracking" author="vargontoc">

        <createTable tableName="recognition_element">
            <column name="id" type="BIGSERIAL">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="topic_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="display_value" type="VARCHAR(50)"/>
            <column name="resource_refs" type="TEXT"/>
            <column name="sort_order" type="INTEGER"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="recognition_element"
            baseColumnNames="topic_id"
            constraintName="fk_recognition_element_topic"
            referencedTableName="topic"
            referencedColumnNames="id"/>

        <addUniqueConstraint
            tableName="recognition_element"
            constraintName="uk_recognition_element_topic_code"
            columnNames="topic_id, code"/>

        <createIndex indexName="idx_recognition_element_topic_status" tableName="recognition_element">
            <column name="topic_id"/>
            <column name="status"/>
        </createIndex>

        <addColumn tableName="activity_attempt">
            <column name="element_id" type="BIGINT"/>
        </addColumn>

        <createIndex indexName="idx_activity_attempt_element" tableName="activity_attempt">
            <column name="element_id"/>
        </createIndex>

        <createTable tableName="element_summary">
            <column name="id" type="BIGSERIAL">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="child_profile_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="element_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="total_attempts" type="INTEGER" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="total_correct" type="INTEGER" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="total_incorrect" type="INTEGER" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="success_rate_percent" type="DECIMAL(5,2)"/>
            <column name="average_response_time_ms" type="INTEGER"/>
            <column name="last_seen_at" type="TIMESTAMPTZ"/>
            <column name="mastery_state" type="VARCHAR(20)"/>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="element_summary"
            baseColumnNames="child_profile_id"
            constraintName="fk_element_summary_child_profile"
            referencedTableName="child_profile"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="element_summary"
            baseColumnNames="element_id"
            constraintName="fk_element_summary_element"
            referencedTableName="recognition_element"
            referencedColumnNames="id"/>

        <addUniqueConstraint
            tableName="element_summary"
            constraintName="uk_element_summary_child_element"
            columnNames="child_profile_id, element_id"/>

        <createIndex indexName="idx_element_summary_child" tableName="element_summary">
            <column name="child_profile_id"/>
        </createIndex>

    </changeSet>
</databaseChangeLog>
