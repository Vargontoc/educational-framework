<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="013__create_dev_seed_state" author="vargontoc">
        <createTable tableName="dev_seed_state">
            <column name="seed_key" type="VARCHAR(200)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="seed_file" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="loaded_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
