<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="002__create_family" author="vargontoc">
        <createSequence sequenceName="default_seq" startValue="1" incrementBy="1"/>

        <createTable tableName="family">
            <column name="id" type="BIGSERIAL">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="pin_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="tts_enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="agent_enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
        </createTable>
        <sql>ALTER TABLE family ADD COLUMN family_stored BOOLEAN GENERATED ALWAYS AS (TRUE) STORED</sql>
        <sql>CREATE UNIQUE INDEX chk_family_single_row ON family(family_stored)</sql>
    </changeSet>

</databaseChangeLog>
