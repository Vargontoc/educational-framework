OLLAMA_HOST=ollama-educational
OLLAMA_PORT=11434
# API_TOKEN or other auth if applicable. Do NOT commit real secrets.
OLLAMA_API_TOKEN=replace-with-token
# GPU-related options
# Set to true to enable GPU mode (requires host NVIDIA drivers and docker with GPU support)
OLLAMA_USE_GPU=true
# Which GPU devices to use (e.g. "all" or "0"); leave as "all" for default
OLLAMA_GPU_DEVICES=all
