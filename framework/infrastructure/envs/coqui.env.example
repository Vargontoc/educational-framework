# Coqui TTS service environment variables
# Copy to coqui.env and fill in values (coqui.env is gitignored)

# Model to load on startup. Must match the command flag in docker-compose.yml.
# See available models: https://github.com/coqui-ai/TTS#available-models
COQUI_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2

# Default language for synthesis. XTTS v2 is multilingual; es = Spanish peninsular.
COQUI_LANGUAGE_IDX=es

# Set to true only when an NVIDIA GPU is available on the host.
# If running CPU-only, override the docker-compose command to remove --use_cuda true.
COQUI_USE_CUDA=true
