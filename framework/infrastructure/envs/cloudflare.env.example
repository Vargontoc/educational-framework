# Cloudflare Tunnel — production only (ADR-006)
# Copy to cloudflare.env and fill in the real token. cloudflare.env is gitignored.
#
# How to generate the token:
#   1. Cloudflare Dashboard → Zero Trust → Networks → Tunnels
#   2. Create a tunnel → name it (e.g. educational-framework-prod)
#   3. Choose "Docker" as the connector environment
#   4. Copy the token shown in the install command (value after --token)
#   5. Paste it as TUNNEL_TOKEN below — cloudflared reads this variable automatically
#
# Ingress rules (routing traffic to backend/frontend) are configured in the
# Cloudflare dashboard under the tunnel's "Public Hostname" tab, not here.

TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token
