# ollama-educational service environment variables
# Copy this file to envs/ollama-educational.env and fill in the values.
# NEVER commit the .env file — only this .env.example is tracked in git.

# Ollama host binding (default: all interfaces inside container)
OLLAMA_HOST=0.0.0.0

# Maximum number of models loaded in memory simultaneously (default: 1)
OLLAMA_MAX_LOADED_MODELS=1

# VRAM to reserve for the GPU context, in bytes (e.g. 4294967296 = 4 GB)
# Leave empty to let Ollama decide automatically
OLLAMA_GPU_MEMORY_FRACTION=

# Flash-attention optimisation (1 = enabled, requires compatible GPU)
OLLAMA_FLASH_ATTENTION=1

# Number of threads used for CPU inference (leave empty = auto-detect)
OLLAMA_NUM_THREAD=

# Log level: debug | info | warn | error (default: info)
OLLAMA_LOG_LEVEL=info
