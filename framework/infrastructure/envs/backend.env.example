# Backend service (api-educational) — runtime environment variables
# Copy to backend.env and fill in real values. backend.env is gitignored.
#
# Profile: dev uses SQL logging and verbose actuator; prod tightens it down.
# Infrastructure sets SPRING_PROFILES_ACTIVE=prod in the prod env file automatically.

# ── Profile ───────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── Database ──────────────────────────────────────────────────────────────────
# Hostname is the docker-compose service name for the postgres container
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-educational:5432/edu_db
SPRING_DATASOURCE_USERNAME=edu
SPRING_DATASOURCE_PASSWORD=change_me

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── Spring AI / Ollama ────────────────────────────────────────────────────────
SPRING_AI_OLLAMA_BASE_URL=http://ollama-educational:11434
SPRING_AI_OLLAMA_CHAT_MODEL=llama3.2

# ── Logging ───────────────────────────────────────────────────────────────────
LOGGING_LEVEL_ES_VARGONTOC=INFO

# ── Security — replace with a strong random secret before first run ───────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_use_openssl_rand_hex_32
JWT_EXPIRATION_MS=86400000


# Map to the desired host IP and Port
API_BIND_IP=127.0.0.1
API_HOST_PORT=8080