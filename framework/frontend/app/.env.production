# Variables de entorno para producción
# Configuración específica para entorno de producción

# Entorno de la aplicación
VITE_ENV=production

# URL base de la API REST (vacío = mismo origen; nginx reenvía /api/* al backend)
VITE_API_BASE_URL=

# URL base del WebSocket (configurar en el entorno de despliegue)
VITE_WS_BASE_URL=wss://

# Modo de la aplicación
VITE_APP_MODE=production
