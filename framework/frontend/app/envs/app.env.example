# Copy this file to .env.development or .env.production and fill in the values.
# Neither of those files is committed — this example is the only reference.

# ── REST API ───────────────────────────────────────────────────────────────────
# dev:  http://localhost:8080
# prod: https://api.yourdomain.com
VITE_API_BASE_URL=

# ── WebSocket ─────────────────────────────────────────────────────────────────
# dev:  ws://localhost:8080
# prod: wss://api.yourdomain.com
VITE_WS_BASE_URL=
