{
  "openapi": "3.1.0",
  "info": {
    "title": "tts-educational",
    "description": "Internal TTS API shell for provider selection, synthesis orchestration, and audio format normalization.",
    "version": "0.2.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/tts/status": {
      "get": {
        "tags": ["tts"],
        "summary": "Status Endpoint",
        "operationId": "status_endpoint_api_v1_tts_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tts/synthesize": {
      "post": {
        "tags": ["tts"],
        "summary": "Synthesize",
        "operationId": "synthesize_api_v1_tts_synthesize_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SynthesizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response — audio/mpeg binary",
            "content": {
              "audio/mpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary",
                  "description": "MP3 audio data"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity — unsupported tone, invalid voice_profile, or provider validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TTSError"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error — provider or conversion error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TTSError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable — provider unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TTSError"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout — synthesis timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TTSError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SynthesizeRequest": {
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text",
            "description": "Text to synthesize"
          },
          "locale": {
            "type": "string",
            "title": "Locale",
            "default": "es",
            "description": "Language locale (e.g., es, en)"
          },
          "tone": {
            "type": "string",
            "title": "Tone",
            "default": "calm",
            "enum": ["calm", "joyful", "enthusiastic", "playful", "serious"],
            "description": "Semantic tone for prosody adjustment"
          },
          "emotion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Emotion",
            "description": "Emotion hint (optional, not currently used)"
          },
          "intensity": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Intensity",
            "description": "Tone intensity (optional, not currently used)"
          },
          "voice_profile": {
            "type": "string",
            "title": "Voice Profile",
            "default": "npc",
            "enum": ["npc", "storyteller"],
            "description": "Voice character: npc (child-friendly) or storyteller (narration)"
          }
        },
        "type": "object",
        "required": ["text"],
        "title": "SynthesizeRequest"
      },
      "StatusResponse": {
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["chatterbox", "xtts"],
            "title": "Provider",
            "description": "Active TTS provider"
          },
          "model": {
            "type": "string",
            "enum": ["chatterbox", "xtts_v2"],
            "title": "Model",
            "description": "TTS model in use"
          },
          "state": {
            "type": "string",
            "title": "State",
            "default": "ready",
            "description": "Service state"
          }
        },
        "type": "object",
        "required": ["provider", "model", "state"],
        "title": "StatusResponse"
      },
      "TTSError": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "type": "string",
                "title": "Code",
                "description": "Error code (e.g., UNSUPPORTED_TONE, SYNTHESIS_TIMEOUT, PROVIDER_UNAVAILABLE, PROVIDER_ERROR)"
              },
              "message": {
                "type": "string",
                "title": "Message",
                "description": "Human-readable error description"
              },
              "retryable": {
                "type": "boolean",
                "title": "Retryable",
                "description": "Whether the request can be retried"
              }
            },
            "type": "object",
            "required": ["code", "message", "retryable"]
          }
        },
        "type": "object",
        "required": ["error"],
        "title": "TTSError"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  }
}