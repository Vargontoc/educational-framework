{
  "openapi": "3.1.0",
  "info": {
    "title": "tts-educational",
    "description": "Internal TTS API shell for provider selection, synthesis orchestration, and audio format normalization.",
    "version": "0.2.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/tts/status": {
      "get": {
        "tags": ["tts"],
        "summary": "Status Endpoint",
        "operationId": "status_endpoint_api_v1_tts_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tts/synthesize": {
      "post": {
        "tags": ["tts"],
        "summary": "Synthesize",
        "operationId": "synthesize_api_v1_tts_synthesize_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SynthesizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response — audio/mpeg binary",
            "content": {
              "audio/mpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary",
                  "description": "MP3 audio data"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity — unsupported tone, invalid context, tone-context mismatch, or provider validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TTSError"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error — provider or conversion error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TTSError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable — provider unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TTSError"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout — synthesis timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TTSError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SynthesizeRequest": {
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text",
            "description": "Text to synthesize"
          },
          "locale": {
            "type": "string",
            "title": "Locale",
            "default": "es",
            "description": "Language locale (e.g., es, en)"
          },
          "context": {
            "type": "string",
            "title": "Context",
            "default": "npc",
            "enum": ["npc", "narration"],
            "description": "Usage context: npc (character dialogue) or narration (storytelling)"
          },
          "tone": {
            "type": "string",
            "title": "Tone",
            "default": "calm",
            "enum": ["calm", "joyful", "enthusiastic", "playful", "serious", "tender", "mysterious"],
            "description": "Semantic tone for prosody adjustment"
          },
          "emotion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Emotion",
            "description": "Emotion hint (optional, not currently used)"
          },
          "intensity": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Intensity",
            "description": "Tone intensity (optional, not currently used)"
          }
        },
        "type": "object",
        "required": ["text"],
        "title": "SynthesizeRequest"
      },
      "StatusResponse": {
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["chatterbox"],
            "title": "Provider",
            "description": "Active TTS provider (Chatterbox único)"
          },
          "model": {
            "type": "string",
            "enum": ["chatterbox"],
            "title": "Model",
            "description": "TTS model in use (Chatterbox)"
          },
          "state": {
            "type": "string",
            "title": "State",
            "default": "ready",
            "description": "Service state"
          }
        },
        "type": "object",
        "required": ["provider", "model", "state"],
        "title": "StatusResponse"
      },
      "ErrorCode": {
        "type": "string",
        "title": "ErrorCode",
        "description": "Códigos de error válidos del servicio TTS",
        "enum": [
          "UNSUPPORTED_TONE",
          "UNSUPPORTED_VOICE_PROFILE",
          "EMPTY_TEXT",
          "MISSING_TEXT",
          "VALIDATION_ERROR",
          "TONE_CONTEXT_MISMATCH",
          "PROVIDER_UNAVAILABLE",
          "PROVIDER_ERROR",
          "PROVIDER_VALIDATION_ERROR",
          "SYNTHESIS_TIMEOUT",
          "CONVERSION_ERROR"
        ]
      },
      "TTSError": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode",
                "title": "Code",
                "description": "Error code: UNSUPPORTED_TONE, UNSUPPORTED_VOICE_PROFILE, EMPTY_TEXT, MISSING_TEXT, VALIDATION_ERROR, TONE_CONTEXT_MISMATCH, PROVIDER_UNAVAILABLE, PROVIDER_ERROR, PROVIDER_VALIDATION_ERROR, SYNTHESIS_TIMEOUT, CONVERSION_ERROR"
              },
              "message": {
                "type": "string",
                "title": "Message",
                "description": "Human-readable error description"
              },
              "retryable": {
                "type": "boolean",
                "title": "Retryable",
                "description": "Whether the request can be retried"
              }
            },
            "type": "object",
            "required": ["code", "message", "retryable"]
          }
        },
        "type": "object",
        "required": ["error"],
        "title": "TTSError"
      }
    }
  }
}