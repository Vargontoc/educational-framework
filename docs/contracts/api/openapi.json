{
  "openapi": "3.0.3",
  "info": {
    "title": "Educational Framework Backend API",
    "description": "Family module API contract.",
    "version": "0.0.1"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created. The raw opaque token is only returned by this endpoint.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseLogin" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error401" } } } }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "No Content" },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error401" } } } }
        }
      }
    },
    "/api/v1/sessions/children": {
      "post": {
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OpenChildSessionRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseChildSession" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error401" } } } },
          "404": { "description": "Not Found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error404" } } } }
        }
      },
      "get": {
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseChildSessionList" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error401" } } } }
        }
      }
    },
    "/api/v1/sessions/children/{id}": {
      "delete": {
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": {
          "204": { "description": "No Content" },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error401" } } } },
          "404": { "description": "Not Found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error404" } } } }
        }
      }
    },
    "/api/v1/sessions/children/{id}/expel": {
      "delete": {
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": {
          "204": { "description": "No Content" },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error401" } } } },
          "404": { "description": "Not Found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error404" } } } }
        }
      }
    },
    "/api/v1/sessions/children/{id}/heartbeat": {
      "post": {
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": {
          "204": { "description": "No Content" },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error401" } } } },
          "404": { "description": "Not Found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error404" } } } }
        }
      }
    },
    "/api/v1/family": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateFamilyRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseFamily" } } } },
          "400": { "description": "Bad Request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error400" } } } },
          "409": { "description": "Conflict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error409" } } } }
        }
      },
      "get": {
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseFamily" } } } },
          "404": { "description": "Not Found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error404" } } } }
        }
      },
      "patch": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateFamilyRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseFamily" } } } },
          "400": { "description": "Bad Request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error400" } } } },
          "404": { "description": "Not Found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error404" } } } }
        }
      }
    },
    "/api/v1/family/children": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateChildProfileRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseChildProfile" } } } },
          "400": { "description": "Bad Request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error400" } } } },
          "404": { "description": "Not Found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error404" } } } }
        }
      },
      "get": {
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseChildProfileList" } } } }
        }
      }
    },
    "/api/v1/family/children/{id}": {
      "get": {
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseChildProfile" } } } },
          "404": { "description": "Not Found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error404" } } } }
        }
      },
      "patch": {
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateChildProfileRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseChildProfile" } } } },
          "400": { "description": "Bad Request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error400" } } } },
          "404": { "description": "Not Found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error404" } } } }
        }
      },
      "delete": {
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": {
          "204": { "description": "No Content" },
          "404": { "description": "Not Found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error404" } } } }
        }
      }
    },
    "/api/v1/family/adults": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateAdultProfileRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseAdultProfile" } } } },
          "400": { "description": "Bad Request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error400" } } } },
          "404": { "description": "Not Found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error404" } } } }
        }
      },
      "get": {
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseAdultProfileList" } } } }
        }
      }
    },
    "/api/v1/family/adults/{id}": {
      "get": {
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseAdultProfile" } } } },
          "404": { "description": "Not Found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error404" } } } }
        }
      },
      "patch": {
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateAdultProfileRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseAdultProfile" } } } },
          "400": { "description": "Bad Request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error400" } } } },
          "404": { "description": "Not Found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error404" } } } }
        }
      },
      "delete": {
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": {
          "204": { "description": "No Content" },
          "404": { "description": "Not Found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error404" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque family session token returned only by POST /api/v1/auth/login."
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "required": ["success"],
        "properties": {
          "success": { "type": "boolean", "example": false },
          "data": { "nullable": true },
          "message": { "type": "string", "nullable": true },
          "errors": { "type": "array", "nullable": true, "items": { "type": "string" } }
        }
      },
      "ApiResponseFamily": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "$ref": "#/components/schemas/FamilyResponse" },
          "message": { "type": "string", "nullable": true },
          "errors": { "type": "array", "nullable": true, "items": { "type": "string" } }
        }
      },
      "ApiResponseChildProfile": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "$ref": "#/components/schemas/ChildProfileResponse" },
          "message": { "type": "string", "nullable": true },
          "errors": { "type": "array", "nullable": true, "items": { "type": "string" } }
        }
      },
      "ApiResponseAdultProfile": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "$ref": "#/components/schemas/AdultProfileResponse" },
          "message": { "type": "string", "nullable": true },
          "errors": { "type": "array", "nullable": true, "items": { "type": "string" } }
        }
      },
      "ApiResponseChildProfileList": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/ChildProfileResponse" } },
          "message": { "type": "string", "nullable": true },
          "errors": { "type": "array", "nullable": true, "items": { "type": "string" } }
        }
      },
      "ApiResponseAdultProfileList": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/AdultProfileResponse" } },
          "message": { "type": "string", "nullable": true },
          "errors": { "type": "array", "nullable": true, "items": { "type": "string" } }
        }
      },
      "ApiResponseLogin": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "$ref": "#/components/schemas/LoginResponse" },
          "message": { "type": "string", "nullable": true },
          "errors": { "type": "array", "nullable": true, "items": { "type": "string" } }
        }
      },
      "ApiResponseChildSession": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "$ref": "#/components/schemas/ChildSessionResponse" },
          "message": { "type": "string", "nullable": true },
          "errors": { "type": "array", "nullable": true, "items": { "type": "string" } }
        }
      },
      "ApiResponseChildSessionList": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/ChildSessionResponse" } },
          "message": { "type": "string", "nullable": true },
          "errors": { "type": "array", "nullable": true, "items": { "type": "string" } }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["pin"],
        "properties": {
          "pin": { "type": "string", "example": "1234" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "description": "Login response. `token` is the raw opaque token and is only returned by POST /api/v1/auth/login.",
        "properties": {
          "token": { "type": "string", "description": "Raw opaque bearer token. Never returned by any other endpoint." },
          "sessionId": { "type": "integer", "format": "int64" },
          "familyId": { "type": "integer", "format": "int64" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "OpenChildSessionRequest": {
        "type": "object",
        "required": ["childProfileId"],
        "properties": {
          "childProfileId": { "type": "integer", "format": "int64" },
          "heartbeatIntervalSeconds": { "type": "integer", "nullable": true, "default": 30 }
        }
      },
      "ChildSessionResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "childProfileId": { "type": "integer", "format": "int64" },
          "familyId": { "type": "integer", "format": "int64" },
          "status": { "type": "string", "enum": ["ACTIVE", "EXPIRED", "EXPELLED", "CLOSED"] },
          "startedAt": { "type": "string", "format": "date-time" },
          "endedAt": { "type": "string", "format": "date-time", "nullable": true },
          "durationSeconds": { "type": "integer", "nullable": true },
          "lastActivityAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateFamilyRequest": {
        "type": "object",
        "required": ["name", "pin", "ttsEnabled", "agentEnabled"],
        "properties": {
          "name": { "type": "string" },
          "pin": { "type": "string" },
          "ttsEnabled": { "type": "boolean" },
          "agentEnabled": { "type": "boolean" }
        }
      },
      "UpdateFamilyRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "pin": { "type": "string", "nullable": true },
          "ttsEnabled": { "type": "boolean", "nullable": true },
          "agentEnabled": { "type": "boolean", "nullable": true }
        }
      },
      "FamilyResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "ttsEnabled": { "type": "boolean" },
          "agentEnabled": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "CreateChildProfileRequest": {
        "type": "object",
        "required": ["name", "birthday", "ttsEnabled", "agentEnabled"],
        "properties": {
          "name": { "type": "string" },
          "birthday": { "type": "string", "format": "date" },
          "avatar": { "type": "string", "nullable": true },
          "ttsEnabled": { "type": "boolean" },
          "agentEnabled": { "type": "boolean" }
        }
      },
      "UpdateChildProfileRequest": {
        "type": "object",
        "required": ["name", "birthday"],
        "properties": {
          "name": { "type": "string" },
          "birthday": { "type": "string", "format": "date" },
          "avatar": { "type": "string", "nullable": true },
          "ttsEnabled": { "type": "boolean", "nullable": true },
          "agentEnabled": { "type": "boolean", "nullable": true }
        }
      },
      "ChildProfileResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "familyId": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "active": { "type": "boolean" },
          "birthday": { "type": "string", "format": "date" },
          "avatar": { "type": "string" },
          "ttsEnabled": { "type": "boolean" },
          "agentEnabled": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "CreateAdultProfileRequest": {
        "type": "object",
        "required": ["name", "birthday"],
        "properties": {
          "name": { "type": "string" },
          "birthday": { "type": "string", "format": "date" },
          "avatar": { "type": "string", "nullable": true }
        }
      },
      "UpdateAdultProfileRequest": {
        "type": "object",
        "required": ["name", "birthday"],
        "properties": {
          "name": { "type": "string" },
          "birthday": { "type": "string", "format": "date" },
          "avatar": { "type": "string", "nullable": true }
        }
      },
      "AdultProfileResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "familyId": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "birthday": { "type": "string", "format": "date" },
          "avatar": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "Error400": {
        "allOf": [{ "$ref": "#/components/schemas/ApiResponse" }],
        "description": "Bad Request error response."
      },
      "Error401": {
        "allOf": [{ "$ref": "#/components/schemas/ApiResponse" }],
        "description": "Unauthorized error response."
      },
      "Error404": {
        "allOf": [{ "$ref": "#/components/schemas/ApiResponse" }],
        "description": "Not Found error response."
      },
      "Error409": {
        "allOf": [{ "$ref": "#/components/schemas/ApiResponse" }],
        "description": "Conflict error response."
      },
      "Error500": {
        "allOf": [{ "$ref": "#/components/schemas/ApiResponse" }],
        "description": "Internal Server Error response."
      }
    }
  }
}
